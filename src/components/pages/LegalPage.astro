---
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { getContent, type Lang } from '../../content';
interface Props { lang: Lang; page: 'privacy' | 'cookie' }
const { lang, page } = Astro.props;
const c = getContent(lang);
const title = page === 'privacy' ? c.legal.privacyTitle : c.legal.cookieTitle;
const body = page === 'privacy' ? c.legal.privacyBody : c.legal.cookieBody;
---
<Base lang={lang} title={`${title} · AdventureLab`} description={c.home.meta.description} page={page}>
  <Nav lang={lang} c={c} page={page} />
  <main id="main" class="container section legal">
    <h1>{title}</h1>
    {body.map((p) => (p.startsWith('## ') ? <h2>{p.slice(3)}</h2> : <p>{p}</p>))}
  </main>
  <Footer lang={lang} c={c} />
</Base>
<style>
  /* Testo lungo da leggere: titoli di sezione più piccoli di quelli delle pagine, righe più corte. */
  .legal h2 { font-size: clamp(18px, 2vw, 22px); max-width: none; margin: var(--space-7) 0 var(--space-3); }
  .legal p { max-width: 68ch; }
</style>
