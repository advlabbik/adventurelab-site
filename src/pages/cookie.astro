---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../content';
const c = getContent('it');
---
<Base lang="it" title={`${c.legal.cookieTitle} — AdventureLab`} description={c.meta.description} path="/cookie/">
  <Nav lang="it" c={c} path="/cookie/" />
  <main id="main" class="container section">
    <h1>{c.legal.cookieTitle}</h1>
    {c.legal.cookieBody.map((p) => <p>{p}</p>)}
  </main>
  <Footer lang="it" c={c} />
</Base>
