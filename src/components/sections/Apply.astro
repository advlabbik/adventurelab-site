---
import type { Lang, SiteContent } from '../../content';
import { href } from '../../lib/routes';
import { site } from '../../../site.config';
import SectionHead from '../SectionHead.astro';
/**
 * La candidatura: un modulo per strada (territorio o azienda) con le domande che
 * servono a preparare la call. Dopo l'invio tutti vedono Calendly (o il grazie, se
 * Calendly non c'è): nessun filtro sul budget, per scelta di Andrea (16/10/2026).
 * La candidatura arriva comunque a collab@ e su Brevo (workers/lead).
 */
interface Props { n: number; lang: Lang; c: SiteContent; kind: 'territorio' | 'brand' }
const { n, lang, c, kind } = Astro.props;
const f = c.form;
const t = c.territori.form;
const a = c.aziende.form;
const head = kind === 'territorio' ? t : a;
const thanks = kind === 'territorio' ? t.thanks : a.thanks;
---
<section id="candidatura" class="section">
  <div class="container apply">
    <SectionHead n={n} label={head.label} title={head.title} intro={head.intro} />

    <form class="apply__form" data-endpoint={site.leadEndpoint} data-calendly={site.calendlyUrl} data-lang={lang} data-kind={kind} novalidate>
      <div class="apply__row">
        <label>{f.name}<input name="name" autocomplete="name" required maxlength="120" /></label>
        <label>{f.email}<input name="email" type="email" autocomplete="email" spellcheck="false" required maxlength="254" /></label>
      </div>
      <div class="apply__row">
        <label>{kind === 'territorio' ? t.org : a.org}<input name="org" autocomplete="organization" required maxlength="160" /></label>
        <label>{f.role}<input name="role" autocomplete="organization-title" maxlength="120" /></label>
      </div>

      {kind === 'territorio' ? (
        <>
          <label>{t.territory}<input name="territory" maxlength="200" required /></label>
          <fieldset>
            <legend>{t.goal}</legend>
            {t.goals.map((g, i) => <label><input type="radio" name="goal" value={g} checked={i === 0} /> {g}</label>)}
          </fieldset>
        </>
      ) : (
        <>
          <div class="apply__row">
            <label>{a.category}
              <select name="category" required>
                <option value="" disabled selected>{a.categoryChoose}</option>
                {a.categories.map((cat) => <option value={cat}>{cat}</option>)}
                <option value={a.categoryOther}>{a.categoryOther}</option>
              </select>
            </label>
            <label>{a.markets}<input name="markets" maxlength="200" /></label>
          </div>
          <fieldset>
            <legend>{a.budget}</legend>
            {a.budgets.map((b, i) => <label><input type="radio" name="budget" value={b} checked={i === a.budgets.length - 1} /> {b}</label>)}
          </fieldset>
        </>
      )}

      <label>{f.success}<span class="apply__hint">{f.successHint}</span><textarea name="success" rows="3" maxlength="1500"></textarea></label>

      <label class="check"><input type="checkbox" name="consent" required /> <a href={href('privacy', lang)}>{f.privacy}</a></label>
      <label class="check"><input type="checkbox" name="optin" /> {f.optin}</label>
      <!-- trappola per i bot: invisibile e fuori dal tab -->
      <label class="sr-only" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
      {site.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-appearance="interaction-only"></div>}
      <p class="apply__error" role="alert" hidden></p>
      <button class="btn btn--primary" type="submit" data-label={f.submit} data-sending={f.sending}>{f.submit}</button>
    </form>

    <p class="apply__thanks" role="status" hidden>{thanks}</p>

    <div class="apply__calendly" hidden>
      <h3>{f.calendlyTitle}</h3>
      <iframe title={f.calendlyTitle} loading="lazy"></iframe>
    </div>

    <p class="apply__mail">{f.fallback} <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
    <noscript><p>{f.fallback} <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p></noscript>

    <script type="application/json" class="apply__errors" set:html={JSON.stringify(f.errors)} />
  </div>
</section>
<style>
  /* Allineata a sinistra come le altre sezioni: si restringe il contenuto, non il contenitore. */
  .apply > * { max-width: 820px; }
  .apply__form { display: grid; gap: var(--space-4); padding: var(--space-5); border: var(--rule-hair) solid var(--ink); background: var(--paper-raised); }
  .apply__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); }
  .apply__form label, .apply__form legend { display: grid; gap: var(--space-2); font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-muted); }
  .apply__form input:not([type=radio]):not([type=checkbox]), .apply__form select, .apply__form textarea { font: 17px/1.4 var(--font-serif); color: var(--ink); padding: var(--space-3); border: var(--rule-hair) solid var(--ink); border-radius: var(--radius-none); background: var(--paper); width: 100%; text-transform: none; letter-spacing: 0; }
  .apply__form textarea { resize: vertical; min-height: 88px; }
  .apply__form input:focus-visible, .apply__form select:focus-visible, .apply__form textarea:focus-visible { outline: var(--rule-strong) solid var(--idro); outline-offset: 0; }
  .apply__form input[type=radio], .apply__form input[type=checkbox] { accent-color: var(--ink); width: 16px; height: 16px; margin: 0; flex: none; }
  .apply__form fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: var(--space-2) var(--space-5); flex-wrap: wrap; }
  .apply__form legend { margin-bottom: var(--space-2); width: 100%; }
  .apply__form fieldset label, .check { display: flex !important; gap: var(--space-2); align-items: center; font: 16px/1.4 var(--font-serif) !important; letter-spacing: 0 !important; text-transform: none !important; color: var(--ink) !important; }
  .apply__hint { font-family: var(--font-serif); font-size: 14px; font-weight: 400; letter-spacing: 0; text-transform: none; font-style: italic; }
  .apply__form .btn { justify-self: start; }
  .apply__error { color: var(--segnavia); font-family: var(--font-mono); font-size: 12px; margin: 0; }
  .apply__thanks { font-family: var(--font-serif); font-style: italic; font-size: 22px; color: var(--idro); border-left: var(--rule-segnavia) solid var(--segnavia); padding-left: var(--space-4); }
  .apply__calendly { border: var(--rule-hair) solid var(--ink); background: var(--paper-raised); padding: var(--space-4); }
  .apply__calendly h3 { font-family: var(--font-display); font-weight: 800; font-stretch: 112%; text-transform: uppercase; font-size: 20px; margin: 0 0 var(--space-3); }
  .apply__calendly iframe { width: 100%; height: 720px; border: 0; }
  .apply__mail { font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); margin-top: var(--space-4); }
  .apply__mail a { color: var(--idro); }
</style>
<script>
  import { sendLeadWithToken } from '../../lib/submit-lead';
  import { calendlyUrl } from '../../lib/calendly';

  declare global { interface Window { turnstile?: { reset: (el?: Element) => void } } }

  const form = document.querySelector<HTMLFormElement>('.apply__form');
  if (form) {
    // Turnstile: lo script si carica una volta sola, solo se il widget c'è.
    if (form.querySelector('.cf-turnstile')) {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      s.async = true; s.defer = true;
      document.head.append(s);
    }
    const root = form.closest('section')!;
    const errorsMap = JSON.parse(root.querySelector('.apply__errors')!.textContent!);
    const errorEl = form.querySelector<HTMLElement>('.apply__error')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const calendly = root.querySelector<HTMLElement>('.apply__calendly')!;
    const kind = form.dataset.kind as 'territorio' | 'brand';

    const showError = (msg: string) => { errorEl.textContent = msg; errorEl.hidden = false; };
    const text = (d: FormData, k: string) => String(d.get(k) ?? '').trim();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn.disabled) return; // doppio clic: un solo invio
      errorEl.hidden = true;
      const d = new FormData(form);
      if (!form.querySelector<HTMLInputElement>('[name=email]')!.checkValidity()) return showError(errorsMap.invalid_email);
      if (!d.get('consent')) return showError(errorsMap.consent_required);
      // Gli altri obbligatori (nome, ente, territorio, categoria): il messaggio del browser basta.
      if (!form.checkValidity()) { form.reportValidity(); return; }

      btn.disabled = true; btn.textContent = btn.dataset.sending!;
      const data = { name: text(d, 'name'), email: text(d, 'email'), org: text(d, 'org') };
      const widget = form.querySelector('.cf-turnstile');
      const tokenInput = () => form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
      const res = await sendLeadWithToken({
        endpoint: form.dataset.endpoint!,
        // Senza widget (sitekey vuota) non c'è token da aspettare.
        tokenWaitMs: widget ? 5000 : 0,
        getToken: () => tokenInput()?.value ?? '',
        resetToken: () => { if (widget) window.turnstile?.reset(widget); },
        payload: {
          ...data,
          type: kind,
          role: text(d, 'role'),
          territory: text(d, 'territory'),
          goal: text(d, 'goal'),
          category: text(d, 'category'),
          markets: text(d, 'markets'),
          budget: text(d, 'budget'),
          success: text(d, 'success'),
          page: location.pathname,
          consent: true,
          optin: d.get('optin') === 'on',
          lang: form.dataset.lang,
          website: d.get('website') ?? '',
        },
      });

      // Errori correggibili dall'utente: resta sul form. Il token Turnstile è
      // già consumato, quindi va rigenerato prima del prossimo invio.
      if (!res.ok && (res.error === 'invalid_email' || res.error === 'consent_required')) {
        if (widget) window.turnstile?.reset(widget);
        btn.disabled = false; btn.textContent = btn.dataset.label!;
        return showError(errorsMap[res.error]);
      }

      if (!res.ok) { console.warn('[lead]', res.error); showError(errorsMap.generic); btn.hidden = true; }
      form.hidden = res.ok; // in caso di errore il messaggio resta visibile, con l'indirizzo email sotto

      const url = calendlyUrl(form.dataset.calendly!, data, location.host);
      if (url) {
        calendly.querySelector('iframe')!.src = url;
        calendly.hidden = false;
        calendly.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      } else if (res.ok) {
        // Calendly non configurato: senza questo il form sparirebbe nel nulla.
        root.querySelector<HTMLElement>('.apply__thanks')!.hidden = false;
      }
    });
  }
</script>
