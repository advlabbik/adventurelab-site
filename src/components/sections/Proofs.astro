---
import type { Item } from '../../content/types';
import SectionHead from '../SectionHead.astro';
/** Elenco numerato di punti di forza, ognuno con la sua prova verificabile sotto. */
interface Props { n: number; id?: string; label: string; title: string; intro: string; items: (Item & { proof: string })[] }
const { n, id, label, title, intro, items } = Astro.props;
---
<section id={id} class="section section--alt">
  <div class="container">
    <SectionHead n={n} label={label} title={title} intro={intro} />
    <ol class="proofs">
      {items.map((it, i) => (
        <li class="proof">
          <span class="proof__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="h3">{it.title}</h3>
            <p class="proof__text">{it.text}</p>
            <p class="proof__proof">{it.proof}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .proofs { list-style: none; padding: 0; margin: 0; border-top: var(--rule-strong) solid var(--ink); }
  .proof { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: var(--space-4); padding: var(--space-5) 0; border-bottom: var(--rule-hair) solid var(--ink); }
  @media (min-width: 900px) { .proof { grid-template-columns: 96px minmax(0, 1fr); } .proof > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-2) var(--space-6); } .proof .h3 { grid-row: span 2; } }
  .proof__n { font-family: var(--font-display); font-weight: 900; font-stretch: 112%; font-size: 40px; line-height: 1; color: var(--segnavia); font-variant-numeric: tabular-nums; }
  .proof__text { margin: var(--space-2) 0 0; max-width: 60ch; }
  @media (min-width: 900px) { .proof__text { margin: 0; } }
  .proof__proof { margin: var(--space-2) 0 0; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: .03em; line-height: 1.6; color: var(--idro); }
</style>
