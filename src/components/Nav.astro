---
import { withBase } from '../lib/paths';
import { Image } from 'astro:assets';
import type { Lang, SiteContent } from '../content';
import logo from '../assets/logos/adventurelab.png';
interface Props { lang: Lang; c: SiteContent; path?: string }
const { lang, c, path = '/' } = Astro.props;
const other = withBase(lang === 'it' ? `/en${path}` : path);
const home = withBase(lang === 'it' ? '/' : '/en/');
const links = [
  ['#territori', c.nav.territories], ['#casi', c.nav.cases], ['#brand', c.nav.brands],
  ['#eventi', c.nav.events], ['#chi-siamo', c.nav.about],
];
---
<a href="#main" class="skip">{c.a11y.skip}</a>
<header class="nav">
  <div class="container nav__in">
    <a href={home} class="nav__logo"><Image src={logo} alt="AdventureLab" height={22} densities={[1, 2]} loading="eager" /></a>
    <nav aria-label={lang === 'it' ? 'Principale' : 'Main'} class="nav__menu">
      <ul class="nav__links">
        {links.map(([href, label]) => <li><a href={`${home}${href}`}>{label}</a></li>)}
      </ul>
    </nav>
    <a href={other} hreflang={lang === 'it' ? 'en' : 'it'} class="nav__lang">{lang === 'it' ? 'EN' : 'IT'}<span class="sr-only"> — {c.langSwitch.label}</span></a>
    <a href={`${home}#contatti`} class="btn btn--primary nav__cta">{c.nav.cta}</a>
  </div>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 10; background: var(--paper); border-bottom: var(--rule-hair) solid var(--ink); }
  .nav__in { display: flex; align-items: center; gap: var(--space-5); min-height: 60px; }
  .nav__logo { margin-right: auto; }
  .nav__logo img { height: 22px; width: auto; }
  .nav__links { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; }
  .nav__links a, .nav__lang { font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; }
  .nav__links a:hover, .nav__lang:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) { .nav__menu { display: none; } }
  @media (max-width: 420px) { .nav__cta { padding-inline: var(--space-3); font-size: 11px; } }
</style>
