---
import { Image } from 'astro:assets';
/** Foto a tutta larghezza con una frase sopra: il respiro tra due sezioni. */
interface Props { src: ImageMetadata; alt: string; text: string; source?: string; caption?: string; position?: string }
const { src, alt, text, source = '', caption = '', position = 'center' } = Astro.props;
---
<figure class="band">
  <Image class="band__img" src={src} alt={alt} widths={[800, 1400, 2000]} sizes="100vw" style={`object-position:${position}`} />
  <figcaption class="band__cap">
    <div class="container">
      <p class="band__text">{text}</p>
      {source && <p class="band__source">{source}</p>}
      {caption && <p class="band__source">{caption}</p>}
    </div>
  </figcaption>
</figure>
<style>
  .band { position: relative; margin: 0; border-top: var(--rule-hair) solid var(--ink); min-height: 420px; display: grid; }
  .band :global(.band__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .band__cap { position: relative; align-self: end; padding: var(--space-8) 0 var(--space-6); background: linear-gradient(to top, rgb(22 25 28 / .82), rgb(22 25 28 / 0)); color: var(--paper-on-ink); }
  .band__text { font-family: var(--font-display); font-weight: 900; font-stretch: 118%; text-transform: uppercase; font-size: clamp(24px, 3.4vw, 40px); line-height: 1.02; max-width: 24ch; margin: 0; text-wrap: balance; }
  .band__source { font-family: var(--font-mono); font-size: 11px; letter-spacing: .05em; color: var(--paper-on-ink); opacity: .85; margin: var(--space-3) 0 0; max-width: 70ch; }
  @media (min-width: 900px) { .band { min-height: 560px; } }
</style>
