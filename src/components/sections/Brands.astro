---
import { existsSync } from 'node:fs';
import type { Lang, SiteContent } from '../../content';
import SectionHead from '../SectionHead.astro';
interface Props { lang: Lang; c: SiteContent }
const { lang, c } = Astro.props;
const kit = lang === 'it' ? 'media-kit.pdf' : 'media-kit-en.pdf';
const hasKit = existsSync(new URL(`../../../public/${kit}`, import.meta.url));
---
<section id="brand" class="section section--ink">
  <div class="container">
    <SectionHead n={5} label={c.sheets.brands} title={c.brands.title} />
    <div class="brands">
      <div><p class="label brands__label">{c.brands.audienceTitle}</p><p class="brands__text">{c.brands.audience}</p></div>
      <div>
        <p class="label brands__label">{c.brands.formatsTitle}</p><p class="brands__text">{c.brands.formats}</p>
        {hasKit && <a class="btn btn--ghost" href={`/${kit}`} download>{c.brands.mediaKit}</a>}
      </div>
    </div>
  </div>
</section>
<style>
  .brands { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); border-top: var(--rule-hair) solid var(--paper-on-ink); padding-top: var(--space-5); }
  .brands__label { color: var(--muted-on-ink); margin: 0 0 var(--space-3); }
  .brands__text { font-size: 20px; line-height: 1.5; margin: 0 0 var(--space-5); max-width: 40ch; }
</style>
