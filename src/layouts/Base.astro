---
import { withBase } from '../lib/paths';
import { routes, type PageKey } from '../lib/routes';
import '../styles/global.css';
// I quattro font del testo d'apertura arrivano prima della prima pittura: con lo
// swap tardivo titolo, sottotitolo e didascalie cambiano altezza e spingono giù
// la foto d'apertura (layout shift). Solo latin: è il sottoinsieme che usiamo.
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import spectralWoff2 from '@fontsource/spectral/files/spectral-latin-400-normal.woff2?url';
import spectralItalicWoff2 from '@fontsource/spectral/files/spectral-latin-400-italic.woff2?url';
import martianWoff2 from '@fontsource-variable/martian-mono/files/martian-mono-latin-wght-normal.woff2?url';
const preloadFonts = [archivoWoff2, spectralWoff2, spectralItalicWoff2, martianWoff2];
import type { Lang } from '../content';
import { site } from '../../site.config';

interface Props { lang: Lang; title: string; description: string; page: PageKey; noAlternates?: boolean }
const { lang, title, description, page, noAlternates = false } = Astro.props;

const origin = Astro.site!.origin;
const urlFor = (l: Lang) => `${origin}${withBase(routes[page][l])}`;
const indexable = import.meta.env.PUBLIC_SITE_ENV === 'production';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {!noAlternates && (
      <>
        <link rel="canonical" href={urlFor(lang)} />
        <link rel="alternate" hreflang="it" href={urlFor('it')} />
        <link rel="alternate" hreflang="en" href={urlFor('en')} />
        <link rel="alternate" hreflang="x-default" href={urlFor('it')} />
      </>
    )}
    <link rel="icon" href={withBase('/favicon.png')} />
    <meta name="theme-color" content="#F1F2EE" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlFor(lang)} />
    <meta property="og:image" content={`${origin}${withBase('/og.jpg')}`} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    {site.cfAnalyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
