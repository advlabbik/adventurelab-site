---
import type { SiteContent } from '../../content';
import SectionHead from '../SectionHead.astro';
interface Props { c: SiteContent }
const { c } = Astro.props;
---
<section id="territori" class="section">
  <div class="container">
    <SectionHead n={2} label={c.sheets.territories} title={c.services.title} />
    <p class="services__intro">{c.services.intro}</p>
    <ul class="services">
      {c.services.items.map((s) => (
        <li><h3 class="h3">{s.title}</h3><p class="muted">{s.text}</p></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .services__intro { font-size: 20px; line-height: 1.5; max-width: 52ch; margin: calc(-1 * var(--space-4)) 0 var(--space-6); }
  /* auto-fit: la griglia regge da 3 a 6 servizi senza toccare il CSS */
  .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); list-style: none; padding: 0; margin: 0; border-top: var(--rule-strong) solid var(--ink); }
  .services li { padding: var(--space-5) var(--space-5) var(--space-6) 0; border-bottom: var(--rule-hair) solid var(--ink); display: grid; gap: var(--space-3); align-content: start; }
  .services p { margin: 0; }
</style>
